{
    "name": "Huffman C++23 - Ubuntu GCC 13 (Default)",
    "image": "ubuntu:24.04",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true,
            "username": "vscode",
            "userUid": "automatic",
            "userGid": "automatic"
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "onCreateCommand": [
        "bash", "-c", 
        "apt-get update && apt-get install -y build-essential cmake gcc-13 g++-13 clang-tidy gdb valgrind ninja-build pkg-config && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 --slave /usr/bin/g++ g++ /usr/bin/g++-13"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "llvm-vs-code-extensions.vscode-clangd",
                "notskm.clang-tidy"
            ],
            "settings": {
                "cmake.configureSettings": {
                    "CMAKE_BUILD_TYPE": "Debug",
                    "CMAKE_CXX_STANDARD": "23",
                    "CMAKE_CXX_COMPILER": "/usr/bin/g++-13"
                },
                "C_Cpp.default.cppStandard": "c++23",
                "C_Cpp.default.compilerPath": "/usr/bin/g++-13"
            }
        }
    },
    "workspaceFolder": "/workspaces/huffman",
    "postCreateCommand": "echo 'Ubuntu GCC 13 devcontainer ready. Run scripts/test-gcc.sh to build and test.'",
    "remoteUser": "vscode"
}